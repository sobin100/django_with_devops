
pipeline{

    agent any




    stages{
        stage('Deploy'){
            steps {
                sh '''
                    ssh ec2-user@13.216.2.10 "
                        docker compose down &&
                        docker compose pull &&
                        docker compose up -d
                    "
                
                '''
            }

        }

        stage('Smoke test'){
            steps {
                sh 'sleep 10'
                sh 'curl http://13.216.2.10:8000'
            }
        }
    }
    post {
       success {
         echo 'CD pipeline completed successfully'
       }
       failure {
         echo 'CD pipeline failed'
       }
    
    }
}