
pipeline{

    agent any




    stages{
        stage('Deploy'){
            steps {
                sh '''
                    ssh ec2-user@98.92.248.97 "
                        cd /home/ec2-user/blog
                        source myenv/bin/activate
                        cd /home/ec2-user/blog/django_with_devops
                        docker compose down &&
                        docker compose pull &&
                        docker compose up -d
                    "
                
                '''
            }

        }

        stage('Smoke test'){
