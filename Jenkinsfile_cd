
pipeline{

    agent any




    stages{
        stage('Deploy'){
            steps {
                sh '''
                    ssh -o StrictHostKeyChecking=no -i SSH_KEY HOST_NAME "
                        
                        cd /home/ec2-user/blog &&
                        source myenv/bin/activate &&
                        cd /home/ec2-user/blog/django_with_devops &&
                        git pull origin main &&
                        docker-compose down &&
                        docker-compose pull &&
                        docker-compose up -d &&
                        docker-compose exec web python manage.py migrate --noinput
                    "
                
                '''
            }

        }

        stage('Smoke test'){
            steps {
                sh 'sleep 10'
                sh 'curl http://3.234.210.134:8000'
            }
        }
    }
    post {
       success {
         echo 'CD pipeline completed successfully'
       }
       failure {
         echo 'CD pipeline failed'
       }
    
    }
}