
pipeline{

    agent any

    environment {
        HOST_NAME= "ec2-user@ec2-3-83-32-46.compute-1.amazonaws.com "
    }

    




    stages{
        stage('Deploy'){
            steps {
                sshagent(['EC2_SSH_KEY']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no  HOST_NAME "
                            
                            cd /home/ec2-user/blog &&
                            source myenv/bin/activate &&
                            cd /home/ec2-user/blog/django_with_devops &&
                            git pull origin main &&
                            docker-compose down &&
                            docker-compose pull &&
                            docker-compose up -d &&
                            docker-compose exec web python manage.py migrate --noinput
                        "
                    
                    '''
                }
            }

        }

        stage('Smoke test'){
            steps {
                sh 'sleep 10'
                sh 'curl http://3.83.32.46:8000'
            }
        }
    }
    post {
       success {
         echo 'CD pipeline completed successfully'
       }
       failure {
         echo 'CD pipeline failed'
       }
    
    }
}